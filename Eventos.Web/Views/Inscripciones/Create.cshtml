@model InscripcionFormulario
@{ ViewData["Title"] = "Nueva inscripción"; }
<div class="page-heading"><div><span class="eyebrow">Participación</span><h1>Nueva inscripción</h1><p class="lead-text">Elige un evento futuro con cupos y una persona activa.</p></div></div>
<div class="editor-shell">
    <form asp-action="Create" method="post" class="form-panel">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-12"><label asp-for="EventoId" class="form-label">Evento</label><select asp-for="EventoId" asp-items="Model.Eventos" class="form-select"><option value="0">Selecciona un evento</option></select><span asp-validation-for="EventoId"></span></div>
            <div class="col-12"><label asp-for="AsistenteId" class="form-label">Asistente</label><select asp-for="AsistenteId" asp-items="Model.Asistentes" class="form-select"><option value="0">Selecciona un asistente</option></select><span asp-validation-for="AsistenteId"></span></div>
        </div>
        <div class="action-row"><button type="submit" class="btn btn-primary">Confirmar inscripción</button><a asp-action="Index" class="btn btn-link">Cancelar</a></div>
    </form>
    <aside class="pass-preview" aria-labelledby="pass-preview-title">
        <div class="pass-preview-photo" role="img" aria-label="Recepción de un evento"></div>
        <div class="pass-preview-body" aria-live="polite">
            <span class="ticket-number">VISTA PREVIA · PASE</span>
            <h2 id="pass-preview-title">Tu próximo encuentro</h2>
            <div class="pass-preview-field"><small>EVENTO</small><strong id="preview-evento">Selecciona un evento</strong></div>
            <div class="pass-preview-field"><small>ASISTENTE</small><strong id="preview-asistente">Selecciona un asistente</strong></div>
            <div class="pass-preview-status" id="preview-estado">Completa los datos para confirmar</div>
        </div>
    </aside>
</div>
@section Scripts {
    <script>
        (() => {
            const evento = document.getElementById('EventoId');
            const asistente = document.getElementById('AsistenteId');
            const pase = document.querySelector('.pass-preview');
            const titulo = document.getElementById('preview-evento');
            const persona = document.getElementById('preview-asistente');
            const estado = document.getElementById('preview-estado');
            if (!evento || !asistente || !pase || !titulo || !persona || !estado) return;
            const actualizar = () => {
                const tieneEvento = Number(evento.value) > 0;
                const tieneAsistente = Number(asistente.value) > 0;
                titulo.textContent = tieneEvento ? evento.selectedOptions[0].textContent : 'Selecciona un evento';
                persona.textContent = tieneAsistente ? asistente.selectedOptions[0].textContent : 'Selecciona un asistente';
                pase.classList.toggle('is-ready', tieneEvento && tieneAsistente);
                estado.textContent = tieneEvento && tieneAsistente ? 'Listo para confirmar' : 'Completa los datos para confirmar';
            };
            evento.addEventListener('change', actualizar);
            asistente.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}
