@model List<Inscripcion>
@{ ViewData["Title"] = "Inscripciones"; }
<section class="media-heading media-heading-checkin" aria-labelledby="inscripciones-title">
    <div class="media-heading-copy"><span class="media-kicker">PARTICIPACIÓN / ACCESO</span><h1 id="inscripciones-title">Cada lugar tiene<br />una historia.</h1><p>Controla confirmaciones y cancelaciones de cada encuentro.</p><a asp-action="Create" class="btn btn-primary">Nueva inscripción <span aria-hidden="true">↗</span></a></div>
    <div class="media-heading-art" role="img" aria-label="Entrega de una entrada en la recepción de un evento"></div>
</section>
<div class="list-heading"><div><span class="eyebrow">REGISTRO</span><h2>Inscripciones</h2></div><span class="count-pill">@Model.Count</span></div>
@if (Model.Count == 0)
{
    <div class="empty"><span class="empty-symbol" aria-hidden="true">✳</span><h3>Los buenos encuentros se comparten</h3><p>Todavía no hay inscripciones.</p><a asp-action="Create" class="btn btn-primary">Crear inscripción</a></div>
}
else
{
    <div class="registration-grid">
        @foreach (var inscripcion in Model)
        {
            <article class="registration-ticket @(inscripcion.Estado == "Confirmada" ? "" : "registration-ticket-cancelled")">
                <div class="registration-main">
                    <div class="registration-top"><span class="ticket-number">INSCRIPCIÓN Nº @inscripcion.Id.ToString("D3")</span><span class="status-badge @(inscripcion.Estado == "Confirmada" ? "status-confirmed" : "status-cancelled")">@inscripcion.Estado</span></div>
                    <h3>@inscripcion.Evento.Titulo</h3>
                    <div class="registration-person"><span>ASISTENTE</span><strong>@inscripcion.Asistente.Nombres</strong></div>
                </div>
                <div class="ticket-divider" aria-hidden="true"></div>
                <div class="registration-stub">
                    <div><small>REGISTRADO</small><span>@inscripcion.FechaInscripcion.ToString("dd/MM/yyyy · HH:mm")</span></div>
                    @if (inscripcion.Estado == "Confirmada")
                    {
                        <form asp-action="Cancelar" asp-route-id="@inscripcion.Id" method="post"><button type="submit" class="btn btn-outline-danger btn-sm">Cancelar inscripción</button></form>
                    }
                    else
                    {
                        <span class="registration-note">Sin acceso vigente</span>
                    }
                </div>
            </article>
        }
    </div>
}
