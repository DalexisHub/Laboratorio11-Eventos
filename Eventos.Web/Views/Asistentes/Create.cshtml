@model AsistenteFormulario
@{ ViewData["Title"] = "Nuevo asistente"; }
<div class="page-heading"><div><span class="eyebrow">Personas</span><h1>Nuevo asistente</h1><p class="lead-text">Registra a una persona para poder inscribirla en eventos.</p></div></div>
<form asp-action="Create" method="post" class="form-panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-12"><label asp-for="Nombres" class="form-label">Nombres</label><input asp-for="Nombres" class="form-control" /><span asp-validation-for="Nombres"></span></div><div class="col-md-6"><label asp-for="Dni" class="form-label">DNI</label><input asp-for="Dni" inputmode="numeric" maxlength="8" class="form-control" /><span asp-validation-for="Dni"></span></div><div class="col-md-6"><label asp-for="Correo" class="form-label">Correo electrónico</label><input asp-for="Correo" type="email" class="form-control" /><span asp-validation-for="Correo"></span></div><div class="col-md-6"><label asp-for="Telefono" class="form-label">Teléfono (opcional)</label><input asp-for="Telefono" maxlength="9" class="form-control" /><span asp-validation-for="Telefono"></span></div></div><div class="action-row"><button class="btn btn-primary" type="submit">Guardar asistente</button><a asp-action="Index" class="btn btn-link">Cancelar</a></div></form>
