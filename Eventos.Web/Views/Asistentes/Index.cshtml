@model List<Asistente>
@{ ViewData["Title"] = "Asistentes"; }

<div class="page-heading">
    <div>
        <span class="eyebrow">Personas</span>
        <h1>Asistentes</h1>
        <p class="lead-text">Consulta a las personas activas que participan en tus eventos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo asistente</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty">Todavía no hay asistentes registrados.</div>
}
else
{
    <div class="table-panel">
        <table class="table">
            <thead><tr><th>Nombre</th><th>DNI</th><th>Correo</th><th>Teléfono</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var asistente in Model)
                {
                    <tr>
                        <td class="fw-semibold">@asistente.Nombres</td>
                        <td>@asistente.Dni</td>
                        <td>@asistente.Correo</td>
                        <td>@(asistente.Telefono ?? "—")</td>
                        <td><span class="status-badge status-confirmed">Activo</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
