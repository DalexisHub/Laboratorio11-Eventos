@model List<Asistente>
@{ ViewData["Title"] = "Asistentes"; }

<section class="media-heading media-heading-people" aria-labelledby="asistentes-title">
    <div class="media-heading-copy"><span class="media-kicker">PERSONAS / COMUNIDAD</span><h1 id="asistentes-title">La gente hace<br />el encuentro.</h1><p>Consulta y organiza a quienes participan en tus eventos.</p><a asp-action="Create" class="btn btn-primary">Nuevo asistente <span aria-hidden="true">↗</span></a></div>
    <div class="media-heading-art" role="img" aria-label="Asistentes conversando en un evento"></div>
</section>
<div class="list-heading"><div><span class="eyebrow">DIRECTORIO</span><h2>Asistentes registrados</h2></div><span class="count-pill">@Model.Count</span></div>

@if (Model.Count == 0)
{
    <div class="empty"><span class="empty-symbol" aria-hidden="true">✳</span><h3>Una comunidad comienza con una persona</h3><p>Todavía no hay asistentes registrados.</p><a asp-action="Create" class="btn btn-primary">Registrar asistente</a></div>
}
else
{
    <div class="table-panel">
        <table class="table">
            <thead><tr><th>Nombre</th><th>DNI</th><th>Correo</th><th>Teléfono</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var asistente in Model)
                {
                    <tr>
                        <td class="fw-semibold">@asistente.Nombres</td>
                        <td>@asistente.Dni</td>
                        <td>@asistente.Correo</td>
                        <td>@(asistente.Telefono ?? "—")</td>
                        <td><span class="status-badge status-confirmed">Activo</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
