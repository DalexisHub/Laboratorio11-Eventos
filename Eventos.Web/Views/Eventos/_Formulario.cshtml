@model EventoFormulario
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input asp-for="Id" type="hidden" />
<div class="row g-3">
  <div class="col-12"><label asp-for="Titulo" class="form-label">Título</label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo"></span></div>
  <div class="col-md-6"><label asp-for="Fecha" class="form-label">Fecha y hora</label><input asp-for="Fecha" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="Fecha"></span></div>
  <div class="col-md-6"><label asp-for="CategoriaId" class="form-label">Categoría</label><select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select"><option value="0">Selecciona una categoría</option></select><span asp-validation-for="CategoriaId"></span></div>
  <div class="col-md-6"><label asp-for="Modalidad" class="form-label">Modalidad</label><select asp-for="Modalidad" class="form-select"><option value="Presencial">Presencial</option><option value="Virtual">Virtual</option></select><span asp-validation-for="Modalidad"></span></div>
  <div class="col-12"><label asp-for="Lugar" class="form-label">Lugar</label><input asp-for="Lugar" class="form-control" /><span asp-validation-for="Lugar"></span></div>
  <div class="col-md-6"><label asp-for="Aforo" class="form-label">Aforo</label><input asp-for="Aforo" type="number" min="1" max="5000" class="form-control" /><span asp-validation-for="Aforo"></span></div>
  <div class="col-md-6"><label asp-for="Precio" class="form-label">Precio (S/)</label><input asp-for="Precio" type="number" min="0" step="0.01" class="form-control" /><span asp-validation-for="Precio"></span></div>
</div>
