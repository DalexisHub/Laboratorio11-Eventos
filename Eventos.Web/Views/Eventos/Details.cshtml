@model Evento
@{ ViewData["Title"] = Model.Titulo; var confirmados = Model.Inscripciones.Count(i => i.Estado == "Confirmada"); }
<div class="page-heading"><div><span class="eyebrow">@Model.Categoria.Nombre</span><h1>@Model.Titulo</h1><p class="lead-text">Detalles y disponibilidad del evento.</p></div></div>
<div class="detail-panel"><dl class="row mb-0"><dt class="col-sm-4">Fecha y hora</dt><dd class="col-sm-8">@Model.Fecha.ToString("f", new System.Globalization.CultureInfo("es-PE"))</dd><dt class="col-sm-4">Modalidad</dt><dd class="col-sm-8">@Model.Modalidad</dd><dt class="col-sm-4">Lugar</dt><dd class="col-sm-8">@Model.Lugar</dd><dt class="col-sm-4">Precio</dt><dd class="col-sm-8">@(Model.Precio == 0 ? "Gratis" : $"S/ {Model.Precio:N2}")</dd><dt class="col-sm-4">Inscripciones</dt><dd class="col-sm-8">@confirmados confirmadas de @Model.Aforo · @(Model.Aforo - confirmados) cupos disponibles</dd></dl><div class="action-row"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar evento</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Desactivar</a><a asp-action="Index" class="btn btn-link">Volver</a></div></div>
