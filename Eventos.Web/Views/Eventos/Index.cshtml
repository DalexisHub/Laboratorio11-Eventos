@model List<Evento>
@{
    ViewData["Title"] = "Eventos";
    var categorias = (List<Categoria>)ViewBag.Categorias;
    int? seleccionada = ViewBag.CategoriaId;
    var confirmadosTotal = Model.Sum(e => e.Inscripciones.Count(i => i.Estado == "Confirmada"));
    var cuposDisponibles = Model.Sum(e => Math.Max(0, e.Aforo - e.Inscripciones.Count(i => i.Estado == "Confirmada")));
    var proximo = Model.Where(e => e.Fecha > DateTime.Now).OrderBy(e => e.Fecha).FirstOrDefault();
    var cuposProximo = proximo is null ? 0 : Math.Max(0, proximo.Aforo - proximo.Inscripciones.Count(i => i.Estado == "Confirmada"));
    var diasProximo = proximo is null ? 0 : (proximo.Fecha.Date - DateTime.Today).Days;
}

<section class="hero @(proximo is null ? "" : "hero-featured")" aria-labelledby="hero-title">
    <div class="hero-content">
        @if (proximo is not null)
        {
            <span class="hero-kicker"><span class="live-dot" aria-hidden="true"></span> PRÓXIMO EN TU AGENDA · @proximo.Categoria.Nombre.ToUpperInvariant()</span>
            <h1 id="hero-title" class="hero-feature-title">@proximo.Titulo</h1>
            <p>@proximo.Fecha.ToString("dddd d 'de' MMMM · HH:mm", new System.Globalization.CultureInfo("es-PE"))<br />@proximo.Lugar · @proximo.Modalidad</p>
            <div class="hero-next-meta"><span>@(diasProximo == 0 ? "Hoy" : diasProximo == 1 ? "Mañana" : $"En {diasProximo} días")</span><span>@cuposProximo @(cuposProximo == 1 ? "cupo libre" : "cupos libres")</span></div>
            <div class="hero-actions"><a class="btn btn-primary hero-button" asp-action="Details" asp-route-id="@proximo.Id">Ver evento <span aria-hidden="true">↗</span></a><a asp-action="Create" class="hero-secondary">Crear otro evento <span aria-hidden="true">＋</span></a></div>
        }
        else
        {
            <span class="hero-kicker"><span class="live-dot" aria-hidden="true"></span> ENCUENTRO / AGENDA DE EVENTOS</span>
            <h1 id="hero-title">Tu próximo encuentro<br /><em>empieza aquí.</em></h1>
            <p>Prepara una nueva experiencia y reúne a las personas indicadas.</p>
            <div class="hero-actions"><a class="btn btn-primary hero-button" asp-action="Create">Crear evento <span aria-hidden="true">↗</span></a><a href="#agenda" class="hero-secondary">Explorar agenda <span aria-hidden="true">↓</span></a></div>
        }
        <div class="hero-metrics" aria-label="Resumen de la agenda">
            <div><strong>@Model.Count.ToString("00")</strong><span>Eventos</span></div>
            <div><strong>@confirmadosTotal.ToString("00")</strong><span>Confirmados</span></div>
            <div><strong>@cuposDisponibles</strong><span>Cupos libres</span></div>
        </div>
    </div>
    <div class="hero-art" role="img" aria-label="Personas reunidas en un evento iluminado al atardecer"><span class="hero-caption">@(proximo is null ? "Diseñado para reunir" : "PRÓXIMO ENCUENTRO")</span></div>
</section>

<section id="agenda" class="agenda-section" aria-labelledby="agenda-title">
    <div class="agenda-toolbar">
        <div class="section-heading"><span class="eyebrow">LA AGENDA</span><h2 id="agenda-title">Próximos encuentros <span class="count-pill">@Model.Count</span></h2></div>
        <form method="get" class="filter-bar">
            <label for="categoriaId">Categoría</label>
            <select id="categoriaId" name="categoriaId" class="form-select">
                <option value="">Todas las categorías</option>
                @foreach (var categoria in categorias)
                {
                    <option value="@categoria.Id" selected="@(seleccionada == categoria.Id)">@categoria.Nombre</option>
                }
            </select>
            <button class="btn btn-outline-primary" type="submit">Aplicar</button>
            @if (seleccionada.HasValue)
            {
                <a asp-action="Index" class="btn btn-link">Limpiar</a>
            }
        </form>
    </div>

@if (Model.Count == 0)
{
    <div class="empty"><span class="empty-symbol" aria-hidden="true">✳</span><h3>La agenda espera su próximo evento</h3><p>No hay eventos para esta categoría.</p><a asp-action="Create" class="btn btn-primary">Crear evento</a></div>
}
else
{
    <div class="event-grid">
        @foreach (var evento in Model)
        {
            var confirmados = evento.Inscripciones.Count(i => i.Estado == "Confirmada");
            var tema = evento.Categoria.Nombre switch { "Tecnología" => "theme-tech", "Cultura" => "theme-culture", "Negocios" => "theme-business", _ => "theme-default" };
            <article class="event-card ticket-card @tema">
                <div class="event-card-top"><span class="date-tile"><strong>@evento.Fecha.ToString("dd")</strong><small>@evento.Fecha.ToString("MMM", new System.Globalization.CultureInfo("es-PE")).ToUpperInvariant()</small></span><span class="category"><span class="category-mark" aria-hidden="true"></span>@evento.Categoria.Nombre</span></div>
                <h2>@evento.Titulo</h2>
                <div class="event-meta">
                    <span><span class="meta-icon" aria-hidden="true">◷</span> @evento.Fecha.ToString("dddd d 'de' MMMM · HH:mm", new System.Globalization.CultureInfo("es-PE"))</span>
                    <span><span class="meta-icon" aria-hidden="true">⌖</span> @evento.Lugar · @evento.Modalidad</span>
                </div>
                <div class="capacity"><div class="capacity-label"><span>@confirmados confirmados</span><span>@(evento.Aforo - confirmados) disponibles</span></div><div class="capacity-track"><span style="width:@(evento.Aforo > 0 ? Math.Min(100, confirmados * 100 / evento.Aforo) : 0)%"></span></div></div>
                <div class="ticket-divider" aria-hidden="true"></div>
                <div class="event-footer">
                    <div>
                        <div class="price">@(evento.Precio == 0 ? "Gratis" : $"S/ {evento.Precio:N2}")</div>
                        <div class="seats">@evento.Aforo cupos en total</div>
                    </div>
                    <a asp-action="Details" asp-route-id="@evento.Id" class="card-link" aria-label="Ver detalles de @evento.Titulo">Ver detalles <span aria-hidden="true">↗</span></a>
                </div>
            </article>
        }
    </div>
}
</section>
