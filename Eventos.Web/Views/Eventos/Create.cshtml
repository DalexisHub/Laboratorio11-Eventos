@model EventoFormulario
@{ ViewData["Title"] = "Crear evento"; }
<div class="page-heading"><div><span class="eyebrow">Eventos</span><h1>Crear evento</h1><p class="lead-text">Completa los datos para publicar un nuevo encuentro.</p></div></div>
<form asp-action="Create" method="post" class="form-panel"><partial name="_Formulario" model="Model" /><div class="action-row"><button class="btn btn-primary" type="submit">Guardar evento</button><a asp-action="Index" class="btn btn-link">Cancelar</a></div></form>
