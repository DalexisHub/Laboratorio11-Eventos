<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Encuentro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-md container-wide">
            <a class="brand" asp-controller="Eventos" asp-action="Index" aria-label="Encuentro, ir a eventos"><span class="brand-mark" aria-hidden="true">✳</span> encuentro<span class="brand-period">.</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto gap-md-2">
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Eventos" ? "active" : "")" asp-controller="Eventos" asp-action="Index">Eventos</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asistentes" ? "active" : "")" asp-controller="Asistentes" asp-action="Index">Asistentes</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inscripciones" ? "active" : "")" asp-controller="Inscripciones" asp-action="Index">Inscripciones</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container-wide page-shell">
        <main role="main">
            @if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success" role="status">@mensaje</div> }
            @RenderBody()
        </main>
    </div>
    <footer class="site-footer container-wide"><span><span class="footer-star" aria-hidden="true">✳</span> encuentro<span class="brand-period">.</span></span><span>Buenas ideas. Mejores encuentros.</span></footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
